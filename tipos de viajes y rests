                    textBoxDescription.Text = "Descripción: Un exclusivo resort frente al mar con villas privadas, piscinas infinitas y gastronomía gourmet. Ideal para escapadas románticas o vacaciones de lujo. Precio: Desde $350 USD por noche.";
                    break;
