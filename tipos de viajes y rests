                    textBoxDescription.Text = "Descripción: Un paraíso ecológico rodeado de naturaleza, con actividades al aire libre como kayak, senderismo y snorkel. Perfecto para amantes de la aventura y la sostenibilidad. Precio: Desde $180 USD por noche.";
                    break;
                case 2:
                    textBoxDescription.Text = "Descripción: Resort todo incluido con acceso directo a la playa, entretenimiento diario y spa de servicio completo. Ideal para familias y grupos grandes. Precio: Desde $250 USD por noche.";
                    break;
            }
        }

        private void buttonReserve_Click_Click(object sender, EventArgs e)
